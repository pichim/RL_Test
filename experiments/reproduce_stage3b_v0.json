{
  "recipe_version": 1,
  "name": "Historical Stage-3b v0 chain",
  "purpose": "Reproduce the exact training ancestry of the frozen 2.4M Stage-3b policy while retaining a paired model/replay state at the selected timestep.",
  "stages": [
    {
      "id": "stage2_scratch_1m",
      "initialization": "scratch",
      "timesteps": 1000000,
      "run_dir": "src/runs/reproduce_stage3b_v0_seed{seed}_stage2_1m",
      "args": ["--current-filter-cutoff-hz", "100"]
    },
    {
      "id": "stage2_continue_1p5m",
      "initialization": "resume",
      "parent": "stage2_scratch_1m",
      "timesteps": 500000,
      "run_dir": "src/runs/reproduce_stage3b_v0_seed{seed}_stage2_1p5m",
      "args": ["--current-filter-cutoff-hz", "100"]
    },
    {
      "id": "stage3b_curriculum",
      "initialization": "curriculum",
      "parent": "stage2_continue_1p5m",
      "timesteps": 2000000,
      "run_dir": "src/runs/reproduce_stage3b_v0_seed{seed}_stage3b",
      "args": [
        "--current-filter-cutoff-hz", "100",
        "--current-filter-cutoff-range-hz", "50", "100",
        "--parameter-randomization",
        "--motor-torque-randomization", "0.10",
        "--arm-mass-randomization", "0.10",
        "--arm-inertia-randomization", "0.10",
        "--pendulum-mass-randomization", "0.10",
        "--pendulum-inertia-randomization", "0.10",
        "--arm-damping-randomization", "0.10",
        "--pendulum-damping-randomization", "0.10",
        "--action-dead-time-max-samples", "1",
        "--randomized-reset-omega1-half-range-rps", "1.5",
        "--randomized-reset-omega2-half-range-rps", "1.5",
        "--curriculum-ramp-steps", "1000000",
        "--curriculum-final-learning-rate", "0.0001",
        "--curriculum-final-learning-rate-steps", "500000",
        "--resume-milestone-timesteps", "2400000"
      ]
    }
  ]
}
