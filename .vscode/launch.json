{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train stage 1: arm velocity 0.015 (default)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/train.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Train stage 2: add 100 Hz filter",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/train.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--current-filter-cutoff-hz",
                "100",
                "--run-dir",
                "${workspaceFolder}/src/runs/sac_200hz_matlab_pure_actor8_critic64_stage2_filter100_v0"
            ]
        },
        {
            "name": "Train stage 3b: refined curriculum seed 0",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/train.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--curriculum-model",
                "${workspaceFolder}/src/runs/sac_200hz_matlab_pure_actor8_critic64_stage2_filter100_v0_selected_to1500k/resume",
                "--timesteps",
                "2000000",
                "--current-filter-cutoff-hz",
                "100",
                "--current-filter-cutoff-range-hz",
                "50",
                "100",
                "--parameter-randomization",
                "--motor-torque-randomization",
                "0.10",
                "--arm-mass-randomization",
                "0.10",
                "--arm-inertia-randomization",
                "0.10",
                "--pendulum-mass-randomization",
                "0.10",
                "--pendulum-inertia-randomization",
                "0.10",
                "--arm-damping-randomization",
                "0.10",
                "--pendulum-damping-randomization",
                "0.10",
                "--action-dead-time-max-samples",
                "1",
                "--randomized-reset-omega1-half-range-rps",
                "1.5",
                "--randomized-reset-omega2-half-range-rps",
                "1.5",
                "--curriculum-ramp-steps",
                "1000000",
                "--curriculum-final-learning-rate",
                "0.0001",
                "--curriculum-final-learning-rate-steps",
                "500000",
                "--seed",
                "0",
                "--run-dir",
                "${workspaceFolder}/src/runs/sac_200hz_matlab_pure_actor8_critic64_stage3b_curriculum_filter50to100_delay1_vel15rps_seed0_v0"
            ]
        },
        {
            "name": "Train: actor transfer (edit paths)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/train.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--initial-actor",
                "${workspaceFolder}/src/runs/previous_run/best/best_model.zip",
                "--run-dir",
                "${workspaceFolder}/src/runs/actor_transfer_experiment"
            ]
        },
        {
            "name": "Train: full resume (edit paths)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/train.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--resume-model",
                "${workspaceFolder}/src/runs/previous_run/final",
                "--run-dir",
                "${workspaceFolder}/src/runs/full_resume_experiment"
            ]
        },
        {
            "name": "Evaluate selected stage3b_v0: SAC and hybrid",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/evaluate.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--results-dir",
                "${workspaceFolder}/src/runs/evaluation_stage3b_v0_selection_recheck"
            ]
        },
        {
            "name": "Finalize stage3b_v0: unseen holdout SAC",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/evaluate.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--controller",
                "sac",
                "--episodes",
                "100",
                "--base-seed",
                "50000",
                "--results-dir",
                "${workspaceFolder}/src/runs/evaluation_stage3b_v0_holdout_sac"
            ]
        },
        {
            "name": "Finalize stage3b_v0: unseen holdout hybrid",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/evaluate.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--controller",
                "hybrid",
                "--episodes",
                "100",
                "--base-seed",
                "50000",
                "--results-dir",
                "${workspaceFolder}/src/runs/evaluation_stage3b_v0_holdout_hybrid"
            ]
        },
        {
            "name": "Finalize stage3b_v0: corner and 30 s stress",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/stress_evaluate.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--profile",
                "both",
                "--controller",
                "both",
                "--long-duration",
                "30",
                "--results-dir",
                "${workspaceFolder}/src/runs/stress_stage3b_v0"
            ]
        },
        {
            "name": "Qualify stage3b_v0: half-rps holdout SAC",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/evaluate.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--controller",
                "sac",
                "--episodes",
                "100",
                "--base-seed",
                "60000",
                "--randomized-arm-velocity-half-range-rps",
                "0.5",
                "--results-dir",
                "${workspaceFolder}/src/runs/evaluation_stage3b_v0_half_rps_v1_sac"
            ]
        },
        {
            "name": "Reproduce Stage3c half-rps: show full chain",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/reproduce.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": ["--all", "--seed", "0"]
        },
        {
            "name": "Reproduce Stage3c half-rps: execute Stage2 scratch",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/reproduce.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--stage",
                "stage2_scratch_1m",
                "--seed",
                "0",
                "--execute"
            ]
        },
        {
            "name": "Reproduce Stage3c half-rps: execute Stage2 to 1.5M",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/reproduce.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--stage",
                "stage2_continue_1p5m",
                "--seed",
                "0",
                "--execute"
            ]
        },
        {
            "name": "Reproduce Stage3c half-rps: execute curriculum",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/reproduce.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--stage",
                "stage3c_curriculum",
                "--seed",
                "0",
                "--execute"
            ]
        },
        {
            "name": "Continue completed Stage3c half-rps: exact +500k",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/train.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--resume-model",
                "${workspaceFolder}/src/runs/reproduce_stage3c_half_rps_v0_seed0_stage3c/final",
                "--timesteps",
                "500000",
                "--current-filter-cutoff-hz",
                "100",
                "--current-filter-cutoff-range-hz",
                "50",
                "100",
                "--parameter-randomization",
                "--motor-torque-randomization",
                "0.10",
                "--arm-mass-randomization",
                "0.10",
                "--arm-inertia-randomization",
                "0.10",
                "--pendulum-mass-randomization",
                "0.10",
                "--pendulum-inertia-randomization",
                "0.10",
                "--arm-damping-randomization",
                "0.10",
                "--pendulum-damping-randomization",
                "0.10",
                "--action-dead-time-max-samples",
                "1",
                "--randomized-reset-omega1-half-range-rps",
                "0.5",
                "--randomized-reset-omega2-half-range-rps",
                "1.5",
                "--run-dir",
                "${workspaceFolder}/src/runs/reproduce_stage3c_half_rps_v0_seed0_stage3c_continued_500k"
            ]
        }
    ]
}
